LOCAL_PATH := device/mediatek/mt6877-common

include $(CLEAR_VARS)

# VINTF fragment shipped with the platform. Only declares the SoC-level
# interfaces that are true of every mt6877 device; a device tree adds its own
# fragments for camera/sensors (com.oplus.*, realme camera provider).
#
# NOW POPULATED: manifest.xml is a verbatim merge of the 18 vendor-side fragments
# pulled from a realme 11 Pro 5G stock A15 device (/vendor/etc/vintf/manifest).
# Each HAL block is copied as-is from its source file -- not invented.

module {
    name: "mt6877.vintf",
    src: {
        "manifest.xml": ["vintf/manifest.xml"],
    },
    product: {
        "*.xml": {
            "container": "framework",
            "product": "mt6877",
        },
    },
    proprietary: true,
}

module {
    name: "mt6877.init.rc",
    src: {
        "init.mt6877.rc": ["init.mt6877.rc"],
    },
    product: {
        "*.rc": {
            "filename": "init.mt6877.rc",
            "mount": "vendor",
            "sub_dir": "etc/init",
        },
    },
    proprietary: true,
}